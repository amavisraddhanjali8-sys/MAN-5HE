# ==============================================================================
# මං 5හේ (Man 5he) — Grade 5 Scholarship Platform Environment Configuration
# ==============================================================================

# --- Core Server & AI Runtime ---
PORT=3000
NODE_ENV="development"
APP_URL="MY_APP_URL"
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- Cryptographic Session, CAPTCHA & TOTP Secrets (Replace with 64-char hex in prod) ---
AUTH_SESSION_SECRET="REPLACE_WITH_256_BIT_RANDOM_HEX_SESSION_SECRET"
CAPTCHA_SIGNING_SECRET="REPLACE_WITH_256_BIT_RANDOM_HEX_CAPTCHA_SECRET"
ENABLE_EMAIL_OTP="false"
ENABLE_TOTP="false"
TOTP_ISSUER_NAME="Man5he Scholarship"
TOTP_WINDOW_STEPS=1
EMAIL_OTP_TTL_SECONDS=600

# --- Persistent Database ---
DATA_STORE_PATH="./data/db.json"
SQLITE_DB_PATH="./data/man5he.sqlite"

# --- Email Dispatch (SMTP / Resend / SendGrid) ---
EMAIL_PROVIDER="smtp"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="noreply@man5he.lk"
SMTP_PASS="MY_SMTP_APP_PASSWORD"
EMAIL_FROM_NAME="මං 5හේ Scholarship Academy"
EMAIL_FROM_ADDRESS="noreply@man5he.lk"

# --- WhatsApp Cloud API / Twilio Automated Progress Dispatch ---
WHATSAPP_PROVIDER="meta_cloud_api"
WHATSAPP_PHONE_NUMBER_ID="MY_META_WHATSAPP_PHONE_NUMBER_ID"
WHATSAPP_ACCESS_TOKEN="MY_META_WHATSAPP_ACCESS_TOKEN"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="MY_WHATSAPP_VERIFY_TOKEN"

# --- Secured Payment Gateway APIs (PayHere Sri Lanka LKR + Stripe Card) ---
PAYMENT_MODE="sandbox"
PAYHERE_MERCHANT_ID="MY_PAYHERE_MERCHANT_ID"
PAYHERE_MERCHANT_SECRET="MY_PAYHERE_MERCHANT_SECRET"
PAYHERE_RETURN_URL="https://man5he.lk/payment/success"
PAYHERE_CANCEL_URL="https://man5he.lk/payment/cancel"
PAYHERE_NOTIFY_URL="https://man5he.lk/api/payments/webhook/confirm"
STRIPE_SECRET_KEY="MY_STRIPE_SECRET_KEY"
STRIPE_WEBHOOK_SECRET="MY_STRIPE_WEBHOOK_SECRET"

# --- Security & Rate Limiting ---
RATE_LIMIT_MAX_ATTEMPTS=10
RATE_LIMIT_WINDOW_MS=900000
ADMIN_BOOTSTRAP_EMAIL="admin@man5he.lk"

